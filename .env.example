# Copy to .env and fill in real values. .env is gitignored - never commit it.

# Used by docker-compose.yml to configure the Postgres container.
POSTGRES_DB=clamped_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Used by clamped-server / clamped-cli / clamped-demo to connect to that same
# database (see clamped-server/src/main/java/io/clamped/server/DataSourceConfig.java).
# Keep these in sync with the POSTGRES_* values above.
CLAMPED_JDBC_URL=jdbc:postgresql://localhost:5432/clamped_db
CLAMPED_USERNAME=postgres
CLAMPED_PASSWORD=changeme
